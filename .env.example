# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------

# MongoDB Connection URI
# For local development (assuming MongoDB is installed locally):
# MONGODB_URI=mongodb://localhost:27017/bible_study_app
#
# For MongoDB Atlas (Recommended for Netlify deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/bible_study_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bible_study_app

# ------------------------------------------------------------------------------
# ADMIN CREDENTIALS
# Used by 'yarn setup-admin' script and the login function
# ------------------------------------------------------------------------------

ADMINUSER=admin
ADMINPASSWORD=password123

# ------------------------------------------------------------------------------
# FRONTEND META TAGS (Vite)
# These are prefixed with VITE_ to be accessible in the frontend code
# ------------------------------------------------------------------------------

VITE_APP_TITLE=PassagePrep
VITE_APP_TAGLINE=Build reusable Bible studies in seconds
VITE_APP_DESCRIPTION=Format, organize, and export Bible study questions with ease.
VITE_APP_URL=https://passage-prep.netlify.app
