# ==============================================================================
# PASSAGEPREP ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE SETTINGS
# ------------------------------------------------------------------------------

# MongoDB Connection String
# Local: mongodb://localhost:27017/bible_study_app
# Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/bible_study_app
MONGODB_URI=mongodb://localhost:27017/bible_study_app

# ------------------------------------------------------------------------------
# ADMIN SETTINGS
# Credentials for management scripts and dashboard login
# ------------------------------------------------------------------------------

ADMINUSER=admin
ADMINPASSWORD=password123

# ------------------------------------------------------------------------------
# FRONTEND SETTINGS (VITE)
# Exposed to the client-side application
# ------------------------------------------------------------------------------

VITE_APP_TITLE=PassagePrep
VITE_APP_TAGLINE=Build reusable Bible studies in seconds
VITE_APP_DESCRIPTION=Format, organize, and export Bible study questions with ease.
VITE_APP_URL=https://passage-prep.netlify.app
